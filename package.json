{
  "name": "docsic",
  "version": "0.1.0",
  "description": "Keeps a codebase legible to coding agents, and keeps that legibility true as the code changes.",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "coding-agents",
    "documentation",
    "agent-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eeshankulk1/docsic.git"
  },
  "homepage": "https://github.com/eeshankulk1/docsic#readme",
  "bugs": {
    "url": "https://github.com/eeshankulk1/docsic/issues"
  },
  "type": "module",
  "bin": {
    "docsic": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
